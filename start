#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
if [ -n "${CARGOX_PYTHON:-}" ]; then
    CARGOX_RUNTIME=$CARGOX_PYTHON
elif [ -x "$ROOT/.venv/bin/python" ]; then
    CARGOX_RUNTIME="$ROOT/.venv/bin/python"
elif [ -x "$ROOT/models/laya-runtime/.venv/bin/python" ]; then
    CARGOX_RUNTIME="$ROOT/models/laya-runtime/.venv/bin/python"
elif command -v python3.12 >/dev/null 2>&1; then
    CARGOX_RUNTIME=$(command -v python3.12)
else
    echo 'CargoX needs Python 3.12. Run: uv sync --extra test' >&2
    exit 1
fi
if ! "$CARGOX_RUNTIME" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 12))'; then
    echo 'CargoX needs Python 3.12. Set CARGOX_PYTHON to its executable.' >&2
    exit 1
fi
exec "$CARGOX_RUNTIME" -m vehicle_days.app "$@"
